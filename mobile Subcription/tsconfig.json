{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "declaration": false,

    // ✅ REMOVED: downlevelIteration — was generating extra iterator runtime
    // code despite targeting ES2022. Only needed for ES5 targets.

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "useDefineForClassFields": false,   // Required for Angular decorators to work correctly

    "lib": [
      "ES2022",
      "dom",
      "dom.iterable"                    // ✅ ADDED: needed for native iterator support
    ],                                  //    that downlevelIteration was compensating for

    "sourceMap": false,
    "strict": false,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,              // Deduplicates tslib helpers across chunks
    "target": "ES2022",                 // Modern output — no transpilation overhead
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}