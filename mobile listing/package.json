{
  "name": "buy-listing-project",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:ssr": "ng build --configuration production",
    "serve:ssr": "node dist/Buy_listing_Project/server/server.mjs",
    "build:serve": "ng build --configuration production && serve dist/Buy_listing_Project/browser -s",
    "serve": "serve dist/Buy_listing_Project/browser -s",
    "dev:ssr": "ng serve --configuration development",

    "stats": "ng build --configuration analyze",
    "wba": "webpack-bundle-analyzer dist/Buy_listing_Project/browser/stats.json",
    "sme": "source-map-explorer dist/Buy_listing_Project/browser/**/*.js",
    "analyze": "npm run stats && npm run wba"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead",
    "not IE 11"
  ],
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/animations": "^21.1.2",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/material": "^21.0.5",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-server": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/ssr": "^21.1.0",
    "bootstrap": "^4.4.1",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "jquery": "^3.7.1",
    "ng-otp-input": "^2.0.9",
    "ngx-countdown": "^21.0.0",
    "ngx-owl-carousel-o": "^21.0.0",
    "ngx-skeleton-loader": "^11.3.0",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.26.17",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.0",
    "@angular/cli": "^21.1.0",
    "@angular/compiler-cli": "^21.1.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^27.1.0",
    "rollup-plugin-visualizer": "^6.0.11",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "webpack-bundle-analyzer": "^5.3.0"
  }
}